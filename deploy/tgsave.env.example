# Пример окружения. Скопируй в /etc/tgsave.env и подставь свои значения.
# Реальный файл должен иметь права 600 и не попадать в git.

API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef
PHONE=+79990000000

# Куда присылать исчезнувшие сообщения: me, @username или id чата
TARGET=me

# Тихий кэш медиа до удаления (по умолчанию «Избранное»)
CACHE=me

# Меню (необязательно): токен бота и твой id
BOT_TOKEN=
OWNER_ID=

SESSION=/var/lib/tgsave/session
DATA_DIR=/var/lib/tgsave
TZ=Europe/Moscow
